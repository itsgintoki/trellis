# ── Chat model ──────────────────────────────────────────────
# Free option: Groq. No credit card. Create a key:
#   https://console.groq.com/keys
# The app auto-detects it and uses openai/gpt-oss-120b (tool calling).
GROQ_API_KEY=

# Paid alternative: OpenAI. If both keys are set, Groq wins unless
# LLM_PROVIDER is set to openai.
# OPENAI_API_KEY=

# Or any OpenAI-compatible endpoint:
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Optional. Force a provider when several keys are present:
# groq | openai | custom
# LLM_PROVIDER=groq

# ── Web search ──────────────────────────────────────────────
# Tavily is the search API the agent uses. It is separate from
# the chat model. Free tier: 1,000 credits/month, no card.
# Create a key at https://www.tavily.com — it starts with tvly-.
TAVILY_API_KEY=

# Optional
# PORT=3000
# DATABASE_PATH=./data/trellis.db
# TIMEZONE=Asia/Calcutta
# DISABLE_EMBEDDINGS=1
# LLM_REASONING_EFFORT=low
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# TAVILY_BASE_URL=https://api.tavily.com
